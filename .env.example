# VerityAI Environment Configuration (Example - Safe Defaults)
# Copy this file to .env and adjust values as needed.

# Application Mode
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & Authentication (Change in production)
JWT_SECRET_KEY=change-this-insecure-secret-key-for-dev-only-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database Configuration (SQLite default for prototype)
DATABASE_URL=sqlite:///./var/verityai.db

# Storage Configuration
STORAGE_BACKEND=local
STORAGE_ROOT=./var/storage
MAX_FILE_SIZE_BYTES=20971520
ALLOWED_MIME_TYPES=["application/pdf","image/jpeg","image/png"]
MAX_PDF_PAGES=30

# Document Processing & OCR
WORKER_CONCURRENCY=2
PDF_TEXT_MIN_CHARS=50
OCR_ENGINE=rapidocr
OCR_LANGUAGE=eng

# Rules & Verification
RULES_DEFINITIONS_DIR=./backend/app/rules/definitions
ACTIVE_VERIFICATION_PROVIDER=simulated
SIMULATED_FIXTURE_PATH=./datasets/simulated_verification/registry.json

# Optional AI / LLM (Disabled by default)
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
