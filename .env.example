# ==============================================================================
# VerityAI Environment Configuration (Example - Safe Defaults)
# Copy this file to .env and adjust values for your deployment environment.
# ==============================================================================

# Application Runtime & Mode
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="VerityAI"
VERSION="1.0.0"
API_V1_PREFIX=/api/v1

# Network Binding & Multi-Computer Demo Configuration
# Default: 127.0.0.1 (local machine only).
# For controlled 2-computer local demonstration (isolated LAN / switch):
# Set HOST=0.0.0.0 and add the client machine's IP / origin to ALLOWED_ORIGINS.
# SECURITY PRECAUTIONS:
# 1. Do NOT bind 0.0.0.0 on public Wi-Fi or untrusted networks.
# 2. Restrict inbound traffic on port 8000 using Windows Defender Firewall or iptables to only the partner machine's IP.
# 3. Development server with reload must never be exposed to the public Internet.
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (JSON array of strings)
# Add your local LAN origins if testing from a second computer (e.g., "http://192.168.1.100:5173")
ALLOWED_ORIGINS=["http://localhost","http://localhost:5173","http://localhost:80","http://127.0.0.1:5173","http://127.0.0.1:8000"]

# Security & Authentication (Change JWT_SECRET_KEY in production!)
JWT_SECRET_KEY=change-this-insecure-secret-key-for-dev-only-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false       # Set to true when serving behind HTTPS
COOKIE_SAMESITE=lax

# Database Configuration (SQLite default with WAL mode; PostgreSQL compatible)
DATABASE_URL=sqlite:///./var/verityai.db

# Storage Configuration (Storage root directory outside public web server)
STORAGE_LOCAL_DIR=./var/uploads
STORAGE_ROOT=./var/uploads
MAX_UPLOAD_SIZE_BYTES=20971520
ALLOWED_UPLOAD_EXTENSIONS=[".pdf",".png",".jpg",".jpeg"]
ALLOWED_UPLOAD_MIME_TYPES=["application/pdf","image/png","image/jpeg"]

# Optional AI / LLM Provider (Core pipeline functions 100% offline without LLM)
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
